{
  // Visit https://aka.ms/tsconfig to read more about this file
  // ts-node must load the ambient global declarations in src/types (*.d.ts) so req.user type-checks at runtime.
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // File Layout
    "rootDir": "./src",
    // Without an outDir, `tsc` drops the compiled .js/.d.ts/.map files next to the sources
    // inside src/. Keep the build output in dist/ (matches package.json "main" and "start").
    "outDir": "./dist",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "commonjs",
    "target": "esnext",
    // "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    "types": ["node", "jest"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    // "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  // api/ is the serverless entry point (outside rootDir); it is built by the platform, not by `tsc`.
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
