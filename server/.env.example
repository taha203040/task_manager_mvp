# # Copy this file to .env and fill in real values. Never commit a populated .env.
# # The API refuses to boot while any variable marked REQUIRED is missing or unsafe.

# NODE_ENV=development
# PORT=4000

# # REQUIRED: PostgreSQL connection string used by src/Config/db.ts
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/task
# # Set to true when the database requires TLS (certificate verification is enforced)
# DATABASE_SSL=false
# DB_CONNECT_TIMEOUT_MS=5000

# # REQUIRED: at least 32 characters. Generate a fresh value with:
# #   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# # The value below is a placeholder and must never be used outside local development.
# JWT_SECRET=CHANGE_ME_generate_a_random_secret_of_at_least_32_chars
# JWT_EXPIRES_IN=1h

# # REQUIRED: comma-separated, exact-match allowlist for CORS (no wildcards)
# CORS_ORIGINS=http://localhost:8080

# # Trusted reverse-proxy hops in front of the API (0 = directly exposed)
# TRUST_PROXY_HOPS=1
